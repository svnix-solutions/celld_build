# Local / manual runs only. Under Komodo these come from the stack's
# Environment (see komodo/resources.toml) and secrets from Komodo variables.

# Docker network Nginx Proxy Manager is attached to (docker network ls).
PROXY_NETWORK=npm_default

# Fleet bucket on the local MinIO. Root credentials: MinIO is dedicated to this fleet.
MINIO_ROOT_USER=celld-admin
MINIO_ROOT_PASSWORD=change-me-to-40-random-chars
CELLD_BUCKET_NAME=celld
# MINIO_DATA=/srv/celld/minio        # bind-mount path instead of a named volume
# MINIO_CONSOLE_PORT=9001

CELLD_VERSION=0.6.2
# CELLD_INTERNAL_SUBNET=172.30.70.0/24
# CELLD_INTERNAL_IP=172.30.70.10
# CELLD_DEPLOY_POLL_S=15
# RUST_LOG=info

# Optional nightly-ish off-host copy to Backblaze B2 (B2 is fine as a backup
# target; it is NOT qualified as a celld fleet bucket).
# COMPOSE_PROFILES=backup
# B2_BUCKET=svnix-celld-backup
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# BACKUP_INTERVAL_S=21600

# App deploy stack (app.compose.yaml)
APP_NAME=hello
APP_DIR=apps/hello
